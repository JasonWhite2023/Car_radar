#set UnusedPin
set_property BITSTREAM.CONFIG.UNUSEDPIN Pullnone [current_design]

#system slock
set_property PACKAGE_PIN Y18 [get_ports clk50m]
set_property IOSTANDARD LVCMOS33 [get_ports clk50m]

#reset active low,
set_property PACKAGE_PIN V17 [get_ports reset_n]
set_property IOSTANDARD LVCMOS33 [get_ports reset_n]

#led
set_property IOSTANDARD LVCMOS33 [get_ports {led[2]}]
set_property IOSTANDARD LVCMOS33 [get_ports {led[1]}]
set_property IOSTANDARD LVCMOS33 [get_ports {led[0]}]
set_property PACKAGE_PIN G17 [get_ports {led[2]}]
set_property PACKAGE_PIN AA18 [get_ports {led[1]}]
set_property PACKAGE_PIN Y19 [get_ports {led[0]}]


#摄像头（板载接口)
set_property PACKAGE_PIN A21 [get_ports {camera_data[7]}]
set_property PACKAGE_PIN C22 [get_ports {camera_data[6]}]
set_property PACKAGE_PIN B22 [get_ports {camera_data[5]}]
set_property PACKAGE_PIN E21 [get_ports {camera_data[4]}]
set_property PACKAGE_PIN D21 [get_ports {camera_data[3]}]
set_property PACKAGE_PIN E22 [get_ports {camera_data[2]}]
set_property PACKAGE_PIN D22 [get_ports {camera_data[1]}]
set_property PACKAGE_PIN C19 [get_ports {camera_data[0]}]
set_property PACKAGE_PIN G22 [get_ports camera_href]
set_property PACKAGE_PIN T21 [get_ports camera_sclk]
set_property PACKAGE_PIN G21 [get_ports camera_sdat]
set_property PACKAGE_PIN U21 [get_ports camera_vsync]
set_property PACKAGE_PIN B21 [get_ports camera_pclk]



set_property IOSTANDARD LVCMOS33 [get_ports {camera_data[0]}]
set_property IOSTANDARD LVCMOS33 [get_ports {camera_data[1]}]
set_property IOSTANDARD LVCMOS33 [get_ports {camera_data[2]}]
set_property IOSTANDARD LVCMOS33 [get_ports {camera_data[3]}]
set_property IOSTANDARD LVCMOS33 [get_ports {camera_data[4]}]
set_property IOSTANDARD LVCMOS33 [get_ports {camera_data[5]}]
set_property IOSTANDARD LVCMOS33 [get_ports {camera_data[6]}]
set_property IOSTANDARD LVCMOS33 [get_ports {camera_data[7]}]
set_property IOSTANDARD LVCMOS33 [get_ports camera_pclk]
set_property IOSTANDARD LVCMOS33 [get_ports camera_href]
set_property IOSTANDARD LVCMOS33 [get_ports camera_vsync]
set_property IOSTANDARD LVCMOS33 [get_ports camera_sdat]
set_property PULLUP true [get_ports camera_sdat]
set_property IOSTANDARD LVCMOS33 [get_ports camera_sclk]
set_property PULLUP true [get_ports camera_sclk]

# 需要提供摄像头reset高电平时添加
set_property PACKAGE_PIN C18 [get_ports camera_rst_n]
set_property IOSTANDARD LVCMOS33 [get_ports camera_rst_n]

# 下面的语句用于PCLK接入非标准时钟接口的情况
set_property CLOCK_DEDICATED_ROUTE FALSE [get_nets camera_pclk_IBUF]

#HDMI
set_property PACKAGE_PIN W19 [get_ports hdmi_clk_p]
set_property IOSTANDARD TMDS_33 [get_ports hdmi_clk_p]
set_property PACKAGE_PIN Y21 [get_ports {hdmi_dat_p[0]}]
set_property IOSTANDARD TMDS_33 [get_ports {hdmi_dat_p[0]}]
set_property PACKAGE_PIN W21 [get_ports {hdmi_dat_p[1]}]
set_property IOSTANDARD TMDS_33 [get_ports {hdmi_dat_p[1]}]
set_property PACKAGE_PIN U22 [get_ports {hdmi_dat_p[2]}]
set_property IOSTANDARD TMDS_33 [get_ports {hdmi_dat_p[2]}]
set_property PACKAGE_PIN AA21 [get_ports hdmi_oe]
set_property IOSTANDARD LVCMOS33 [get_ports hdmi_oe]

#VGA
